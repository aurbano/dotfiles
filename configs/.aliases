alias p="ps -m -o pid,user,%mem,args"

alias hosts='sudo $EDITOR /etc/hosts'   # yes I occasionally 127.0.0.1 twitter.com ;)

# GIT STUFF

# Delete local branches already merged into the current one (keeps main-line branches).
alias gclean='git branch --merged | command grep -Ev "^\*|^[[:space:]]*(master|main|develop|staging)$" | xargs -r git branch -d'

# IP addresses
alias ip="dig +short myip.opendns.com @resolver1.opendns.com"
alias localip="ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1"
alias ips="ifconfig -a | perl -nle'/(\d+\.\d+\.\d+\.\d+)/ && print $1'"

# Answer section only, multi-line records
alias digs="dig +noall +answer +multiline"

# Flush the DNS cache
alias flushdns="sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder"

# Trim new lines and copy to clipboard
alias trimcopy="tr -d '\n' | pbcopy"

# Recursively delete `.DS_Store` files
alias cleands="command find . -name '*.DS_Store' -type f -delete"

# File size
alias fs="stat -f \"%z bytes\""

# Empty the Trash through Finder (same as the menu item, no sudo rm)
alias emptytrash="osascript -e 'tell application \"Finder\" to empty trash'"

# Modern tools. Standard names (cat, ls, find, grep, diff) stay the real tools so
# pasted commands, scripts and agent shells behave as documented.
export LESS='-R --use-color'

if command -v bat &>/dev/null; then
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
fi

if command -v eza &>/dev/null; then
  alias ll='eza -l --group-directories-first'
  alias la='eza -la --group-directories-first'
  alias lt='eza --tree --level=2'
fi

if command -v nvim &>/dev/null; then
  alias vim='nvim'
fi

# Benchmarking
alias zsh-bench='for i in $(seq 10); do /usr/bin/time zsh -i -c exit; done 2>&1 | grep real'

# Tmux
alias tl='tmux list-sessions 2>/dev/null || echo "no sessions"'
alias tk='tmux kill-session'
# iTerm2 tmux control mode — tmux windows/panes become native iTerm2 tabs/splits
alias tit='tmux -CC new-session -A -s main'

# Claude Code (permission mode comes from ~/.claude/settings.json)
alias cc='claude'
alias ccc='claude --continue'
alias ccr='claude --resume'
