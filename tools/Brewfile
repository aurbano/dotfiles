# ─── Shell ───────────────────────────────────────────────────────────────────
brew "bash"                        # macOS ships bash 3.2; this gives 5.x
brew "zsh"
brew "zsh-syntax-highlighting"
brew "zsh-history-substring-search"
brew "zsh-completions"             # extra completions (~200 tools)
brew "pure"

# ─── Modern CLI replacements ─────────────────────────────────────────────────
brew "bat"                         # cat
brew "eza"                         # ls
brew "fd"                          # find
brew "ripgrep"                     # grep
brew "zoxide"                      # cd
brew "fzf"                         # fuzzy finder
brew "atuin"                       # shell history search (Ctrl-R)
brew "git-delta"                   # diff

# ─── Git & GitHub ────────────────────────────────────────────────────────────
brew "git"
brew "gh"

# ─── GNU core utils ──────────────────────────────────────────────────────────
brew "coreutils"
brew "gnu-sed"
brew "moreutils"                   # sponge, ts, etc.

# ─── Terminal multiplexer ────────────────────────────────────────────────────
brew "tmux"

# ─── Essential tools ─────────────────────────────────────────────────────────
brew "wget"
brew "jq"
brew "yq"                          # jq for YAML
brew "xh"                          # modern curl/httpie alternative
brew "llm"                         # LLM CLI (Simon Willison)
brew "neovim"
brew "tree-sitter-cli"             # required by nvim-treesitter for :TSInstall
brew "htop"
brew "tree"
brew "pv"                          # pipe viewer
brew "entr"                        # run cmd on file change
brew "tlrc"                        # tldr client (tldr formula was deprecated 2025-10-24)
brew "mtr"                         # network diagnostics
brew "nmap"

# ─── Dev tooling (shell/CI linters, AST search, file utils) ──────────────────
brew "ast-grep"                    # AST-based code search
brew "shellcheck"                  # shell linter
brew "shfmt"                       # shell formatter
brew "actionlint"                  # GitHub Actions linter
brew "zizmor"                      # Actions security audit
brew "macos-trash"                 # `trash` — safer rm
brew "timvw/tap/wt"                # git worktree wrapper

# ─── Node ────────────────────────────────────────────────────────────────────
brew "fnm"                         # fast node manager

# ─── Python ──────────────────────────────────────────────────────────────────
brew "uv"

# ─── Media ───────────────────────────────────────────────────────────────────
brew "ffmpeg"

# ─── Kubernetes ───────────────────────────────────────────────────────────────
brew "kubernetes-cli"              # kubectl
brew "kubie"                       # k8s context/namespace switcher (per-shell isolation)

# ─── Fonts ───────────────────────────────────────────────────────────────────
cask "font-hack-nerd-font"         # nerd font for nvim/lualine icons

# ─── Casks ───────────────────────────────────────────────────────────────────
cask "ghostty"
cask "raycast"                     # launcher on ⌘Space, clipboard history
cask "suspicious-package"          # inspect .pkg installers
