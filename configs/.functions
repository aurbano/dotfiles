# Create a new directory and enter it
mkcd() {
  mkdir -p "$1" && cd "$1"
}

# Find process using a port
port() {
  [[ "$1" =~ ^[0-9]+$ ]] || { echo "Usage: port <number>"; return 1; }
  lsof -i ":${1}"
}

# Start an HTTP server from a directory, optionally specifying the port
function serve() {
	local port="${1:-8000}"
	open "http://localhost:${port}/"
	python3 -m http.server "$port"
}


# Extract an archive into a new directory named after it: extract <file>
extract() {
  [[ -f "$1" ]] || { echo "extract: '$1' is not a file" >&2; return 1; }
  local file="${1:A}" dir="${${1:t}%%.*}"
  [[ -e "$dir" ]] && { echo "extract: '$dir' already exists" >&2; return 1; }
  mkdir -p "$dir" && cd "$dir" || return 1
  case "$file" in
    *.tar|*.tar.*|*.tgz|*.tbz|*.tbz2|*.tb2|*.txz|*.taz|*.zip|*.7z|*.rar|*.cpio|*.iso)
      tar -xf "$file" ;;  # bsdtar (macOS tar) reads all of these
    *.zst) zstd -d "$file" -o "${${file:t}%.zst}" ;;
    *.xz)  xz -dk "$file" && mv "${file%.xz}" . ;;
    *.gz)  gunzip -c "$file" > "${${file:t}%.gz}" ;;
    *)     echo "extract: unsupported archive '$1'" >&2; cd .. && rmdir "$dir"; return 1 ;;
  esac
}

# Animated GIF from any video: gifify <video> [width]  (default width 600)
# Two-pass palette keeps colours accurate without ImageMagick or gifsicle.
gifify() {
  command -v ffmpeg &>/dev/null || { echo "gifify: ffmpeg is required (brew install ffmpeg)" >&2; return 1; }
  [[ -f "$1" ]] || { echo "Usage: gifify <video> [width]" >&2; return 1; }
  local width="${2:-600}"
  local filters="fps=10,scale=${width}:-1:flags=lanczos"
  ffmpeg -v warning -i "$1" \
    -vf "${filters},split[a][b];[a]palettegen=stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=5" \
    -loop 0 "${1:r}.gif"
}

# Automatically list directory contents on `cd`.
auto-ls () {
	emulate -L zsh
	if command -v eza &>/dev/null; then
		eza -aF --group-directories-first
	elif hash gls 2>/dev/null; then
		CLICOLOR_FORCE=1 gls -aFh --color --group-directories-first
	else
		ls
	fi
}
chpwd_functions=( auto-ls $chpwd_functions )

# Smart tmux session switcher
# Usage: t [name]  — create or attach a named session; no args = fzf picker or "main"
(( $+aliases[t] )) && unalias t
t() {
  local session="${1:-}"

  if [[ -n "$TMUX" ]]; then
    # Already inside tmux: switch sessions instead of attaching
    if [[ -n "$session" ]]; then
      tmux new-session -d -s "$session" 2>/dev/null
      tmux switch-client -t "$session"
    elif command -v fzf &>/dev/null; then
      tmux list-sessions -F "#{session_name}" \
        | fzf --height=10 --reverse --prompt="session: " \
        | xargs -r tmux switch-client -t
    else
      tmux choose-tree -s
    fi
  else
    # Outside tmux: create or attach (new-session -A attaches if already exists)
    tmux new-session -A -s "${session:-main}"
  fi
}

# Quick LLM query
ai() {
  echo "$*" | llm
}

# AI-generated commit message from staged diff
gcai() {
  git diff --cached | llm "Write a concise git commit message for these changes. Just the message, no explanation."
}
