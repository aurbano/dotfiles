[alias]
	c = commit -am
	up = pull
	p = push
	s = status -s
	df = diff --color --color-words --abbrev
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --
	co = checkout
	# difftastic: structural diffs that ignore formatting-only changes
	dft = -c diff.external=difft diff
	dlog = -c diff.external=difft log -p --ext-diff
	dshow = -c diff.external=difft show --ext-diff

	undo = reset --soft HEAD^
	# Not quite as common as an amend, but still common
	# https://git-scm.com/docs/git-reset#git-reset-emgitresetemltmodegtltcommitgt

	stash-all = stash push --include-untracked
	# We wanna grab those pesky un-added files!
	# https://git-scm.com/docs/git-stash

	# Show the diff between the latest commit and the current state
	d = !"git diff-index --quiet HEAD -- || clear; git --no-pager diff --patch-with-stat"

	# Merge GitHub pull request on top of the current branch
	mpr = "!f() { \
		if [ $(printf \"%s\" \"$1\" | grep '^[0-9]\\+$' > /dev/null; printf $?) -eq 0 ]; then \
			_default=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@'); \
			_default=${_default:-main}; \
			git fetch origin refs/pull/$1/head:pr/$1 && \
			git rebase $_default pr/$1 && \
			git checkout $_default && \
			git merge pr/$1 && \
			git branch -D pr/$1 && \
			git commit --amend -m \"$(git log -1 --pretty=%B)\n\nCloses #$1.\"; \
		fi \
	}; f"
	branch-prune = "!git fetch -p && for b in $(git for-each-ref --format='%(if:equals=[gone])%(upstream:track)%(then)%(refname:short)%(end)' refs/heads); do git branch -d $b; done"

[color]
	ui = auto

[core]
	excludesfile = ~/dotfiles/configs/gitignore_global
	attributesfile = ~/dotfiles/configs/gitattributes_global
	pager = delta
	editor = nvim
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
[color "status"]
	added = yellow
	changed = green
	untracked = cyan
[merge]
	tool = nvimdiff
	conflictstyle = zdiff3
	autostash = true

[delta]
	navigate = true
	line-numbers = true
	side-by-side = false

[interactive]
	diffFilter = delta --color-only

# rewrites
[url "git@github.com:"]
	insteadOf = "gh:"
	insteadOf = "git://github.com"
	pushInsteadOf = "github:"
	pushInsteadOf = "git://github.com/"
	pushInsteadOf = "https://github.com/"
[url "git@gist.github.com:"]
	insteadOf = "gst:"
	pushInsteadOf = "gist:"
	pushInsteadOf = "git://gist.github.com/"
	pushInsteadOf = "https://gist.github.com/"

[help]
	autocorrect = prompt

# push easily. http://stackoverflow.com/a/23918418/89484
[push]
	default = simple
	autoSetupRemote = true
	followTags = true

[credential]
	helper = osxkeychain
[commit]
	gpgsign = true
[gpg]
	format = ssh
[pull]
	rebase = true
[fetch]
	prune = true

[diff]
	algorithm = histogram
	colorMoved = zebra
[init]
	defaultBranch = main
[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[column]
	ui = auto
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[user]
	name = Alejandro Alvarez
	email = aluralma@gmail.com

# Machine-local identity, signing key and overrides. Last, so it wins.
[include]
	path = ~/.gitconfig.local
